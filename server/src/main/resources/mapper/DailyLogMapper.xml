<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mayonedev.battle.domain.gamification.dao.DailyLogDao">

    <resultMap id="dailyLogResultMap" type="com.mayonedev.battle.domain.gamification.entity.DailyLog">
        <id property="userId" column="user_id"/>
        <id property="logDate" column="log_date"/>
        <result property="isAttended" column="is_attended"/>
        <result property="dailyExp" column="daily_exp"/>
    </resultMap>

    <insert id="insert" parameterType="com.mayonedev.battle.domain.gamification.entity.DailyLog">
        INSERT INTO daily_log (user_id, log_date, is_attended, daily_exp)
        VALUES (#{userId}, #{logDate}, #{isAttended}, #{dailyExp})
    </insert>

    <select id="findByUserAndDate" resultMap="dailyLogResultMap">
        SELECT *
        FROM daily_log
        WHERE user_id = #{userId} AND log_date = #{logDate}
    </select>

    <update id="update" parameterType="com.mayonedev.battle.domain.gamification.entity.DailyLog">
        UPDATE daily_log
        SET is_attended = #{isAttended},
            daily_exp = #{dailyExp}
        WHERE user_id = #{userId} AND log_date = #{logDate}
    </update>

</mapper>
