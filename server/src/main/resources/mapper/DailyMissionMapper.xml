<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mayonedev.battle.domain.gamification.dao.DailyMissionDao">

    <resultMap id="dailyMissionResultMap" type="com.mayonedev.battle.domain.gamification.entity.DailyMission">
        <id property="missionId" column="mission_id"/>
        <result property="title" column="title"/>
        <result property="missionType" column="mission_type"/>
        <result property="goalCount" column="goal_count"/>
        <result property="rewardExp" column="reward_exp"/>
        <result property="isActive" column="is_active"/>
    </resultMap>

    <select id="findAll" resultMap="dailyMissionResultMap">
        SELECT * FROM daily_mission WHERE is_active = 1
    </select>
    
    <select id="findById" resultMap="dailyMissionResultMap">
    	SELECT * FROM daily_mission WHERE mission_id = #{missionId}
    </select>

</mapper>
