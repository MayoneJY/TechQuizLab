<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mayonedev.battle.dao.AchievementDao">

    <resultMap id="achievementResultMap" type="com.mayonedev.battle.entity.Achievement">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="conditionType" column="condition_type"/>
        <result property="conditionValue" column="condition_value"/>
        <result property="rewardExp" column="reward_exp"/>
        <result property="imgUrl" column="img_url"/>
    </resultMap>

    <select id="findAll" resultMap="achievementResultMap">
        SELECT * FROM achievement
    </select>

    <select id="findById" parameterType="long" resultMap="achievementResultMap">
        SELECT * FROM achievement WHERE id = #{id}
    </select>

    <select id="findByConditionType" parameterType="string" resultMap="achievementResultMap">
        SELECT * FROM achievement WHERE condition_type = #{conditionType}
    </select>

</mapper>
