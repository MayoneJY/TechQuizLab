<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mayonedev.battle.dao.QuestionBookmarkDao">

    <resultMap id="bookmarkResultMap" type="com.mayonedev.battle.entity.QuestionBookmark">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="questionId" column="question_id"/>
        <result property="memo" column="memo"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByUserId" parameterType="long" resultMap="bookmarkResultMap">
        SELECT id, user_id, question_id, memo, created_at
        FROM question_bookmark
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <insert id="insert" parameterType="com.mayonedev.battle.entity.QuestionBookmark" 
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO question_bookmark (user_id, question_id, memo, created_at)
        VALUES (#{userId}, #{questionId}, #{memo}, #{createdAt})
    </insert>

    <delete id="deleteById" parameterType="long">
        DELETE FROM question_bookmark
        WHERE id = #{id}
    </delete>

    <select id="existsByUserIdAndQuestionId" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM question_bookmark
        WHERE user_id = #{userId} AND question_id = #{questionId}
    </select>

</mapper>
