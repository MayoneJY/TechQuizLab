<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mayonedev.battle.dao.StageDao">

    <resultMap id="stageResultMap" type="com.mayonedev.battle.entity.Stage">
        <id property="stageId" column="stage_id"/>
        <result property="companyName" column="company_name"/>
        <result property="title" column="title"/>
        <result property="jobCategory" column="job_category"/>
        <result property="content" column="content"/>
        <result property="deadline" column="deadline"/>
    </resultMap>

    <select id="findAll" resultMap="stageResultMap">
        SELECT *
        FROM stage
        ORDER BY stage_id DESC
    </select>

    <select id="findById" parameterType="long" resultMap="stageResultMap">
        SELECT *
        FROM stage
        WHERE stage_id = #{stageId}
    </select>

    <insert id="insert" parameterType="com.mayonedev.battle.entity.Stage" 
            useGeneratedKeys="true" keyProperty="stageId">
        INSERT INTO stage (
            company_name, title, job_category, content, deadline
        )
        VALUES (
            #{companyName}, #{title}, #{jobCategory}, #{content}, #{deadline}
        )
    </insert>

</mapper>
