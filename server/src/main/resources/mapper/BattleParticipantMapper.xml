<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mayonedev.battle.dao.BattleParticipantDao">

    <resultMap id="participantResultMap" type="com.mayonedev.battle.entity.BattleParticipant">
        <id property="id" column="id"/>
        <result property="battleId" column="battle_id"/>
        <result property="userId" column="user_id"/>
        <result property="role" column="role"/>
        <result property="score" column="score"/>
        <result property="joinedAt" column="joined_at"/>
    </resultMap>

    <select id="findByBattleId" parameterType="long" resultMap="participantResultMap">
        SELECT id, battle_id, user_id, role, score, joined_at
        FROM battle_participant
        WHERE battle_id = #{battleId}
    </select>

    <insert id="insert" parameterType="com.mayonedev.battle.entity.BattleParticipant" 
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO battle_participant (battle_id, user_id, role, score, joined_at)
        VALUES (#{battleId}, #{userId}, #{role}, #{score}, #{joinedAt})
    </insert>

    <update id="updateScore" parameterType="com.mayonedev.battle.entity.BattleParticipant">
        UPDATE battle_participant
        SET score = #{score}
        WHERE id = #{id}
    </update>

</mapper>
