<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mayonedev.battle.domain.board.dao.BoardCommentDao">
    <resultMap id="BoardCommentDtoMap" type="com.mayonedev.battle.domain.board.dto.CommentDto">
        <id property="commentId" column="comment_id"/>
        <result property="boardId" column="board_id"/>
        <result property="postId" column="post_id"/>
        <result property="userId" column="user_id"/>
        <result property="parentCommentId" column="parent_comment_id"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="nickname" column="nickname"/>
    </resultMap>   

    <!-- Result Map for Comment Entity -->
    <resultMap id="CommentMap" type="com.mayonedev.battle.domain.board.entity.Comment">
        <id property="commentId" column="comment_id"/>
        <result property="boardId" column="board_id"/>
        <result property="postId" column="post_id"/>
        <result property="userId" column="user_id"/>
        <result property="parentCommentId" column="parent_comment_id"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>

    <!-- 댓글 조회 -->
    <select id="selectCommentsByPost" resultMap="BoardCommentDtoMap">
        SELECT 
            c.comment_id, 
            c.board_id, 
            c.post_id, 
            c.user_id, 
            c.parent_comment_id, 
            c.content, 
            c.created_at, 
            c.is_deleted, 
            COALESCE(u.nickname, '탈퇴한 사용자') AS nickname
        FROM comment c
        LEFT JOIN user u ON c.user_id = u.user_id
        WHERE c.board_id = #{boardId}
          AND c.post_id = #{postId}
        ORDER BY c.created_at ASC
    </select>

    <!-- 댓글 ID로 댓글 조회 -->
    <select id="selectByCommentId" resultMap="CommentMap">
        SELECT 
            comment_id,
            board_id,
            post_id,
            user_id,
            parent_comment_id,
            content,
            created_at,
            is_deleted
        FROM comment
        WHERE board_id = #{boardId}
          AND post_id = #{postId}
          AND comment_id = #{commentId}
    </select>

    <!-- 댓글 등록 -->
    <insert id="insertComment"
        parameterType="com.mayonedev.battle.domain.board.entity.Comment"
        useGeneratedKeys="true"
        keyProperty="commentId">

        INSERT INTO comment
            (board_id, post_id, user_id, parent_comment_id, content)
        VALUES
            (#{boardId}, #{postId}, #{userId}, #{parentCommentId}, #{content})
    </insert>


    <!-- 댓글 삭제(soft delete version) -->
    <update id="softDeleteComment" parameterType="long">
        UPDATE comment
        SET is_deleted = 1
        WHERE comment_id = #{commentId}
    </update>

    <!-- 댓글 삭제(hard delete version) -->
    <delete id="deleteComment" parameterType="long">
        DELETE FROM comment
        WHERE comment_id = #{commentId}
    </delete>
    
    <!-- 댓글 부모 참조 해제 (NULL로 업데이트) - 순환 참조 회피 -->
    <update id="disconnectComments">
        UPDATE comment
        SET parent_comment_id = NULL
        WHERE board_id = #{boardId} AND post_id = #{postId}
    </update>

    <!-- 게시글의 모든 댓글 일괄 삭제 -->
    <delete id="deleteCommentsByPostId">
        DELETE FROM comment 
        WHERE board_id = #{boardId} AND post_id = #{postId}
    </delete>

</mapper>