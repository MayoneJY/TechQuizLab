<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mayonedev.battle.domain.board.dao.BoardCommentDao">
    <resultMap id="BoardCommentDtoMap" type="com.mayonedev.battle.domain.board.dto.CommentDto">
        <id property="comment_id" column="comment_id"/>
        <result property="board_id" column="board_id"/>
        <result property="post_id" column="post_id"/>
        <result property="user_id" column="user_id"/>
        <result property="parent_comment_id" column="parent_comment_id"/>
        <result property="content" column="content"/>
        <result property="created_at" column="created_at"/>
        <result property="is_deleted" column="is_deleted"/>
        <result property="nickname" column="nickname"/>
    </resultMap>   

    <!-- Result Map for Comment Entity -->
    <resultMap id="CommentMap" type="com.mayonedev.battle.domain.board.entity.Comment">
        <id property="comment_id" column="comment_id"/>
        <result property="board_id" column="board_id"/>
        <result property="post_id" column="post_id"/>
        <result property="user_id" column="user_id"/>
        <result property="parent_comment_id" column="parent_comment_id"/>
        <result property="content" column="content"/>
        <result property="created_at" column="created_at"/>
        <result property="is_deleted" column="is_deleted"/>
    </resultMap>

    <!-- 댓글 조회 -->
    <select id="selectCommentsByPost" resultMap="BoardCommentDtoMap">
        SELECT 
            c.comment_id, 
            c.board_id, 
            c.post_id, 
            c.user_id, 
            c.parent_comment_id, 
            c.content, 
            c.created_at, 
            c.is_deleted, 
            COALESCE(u.nickname, '탈퇴한 사용자') AS nickname
        FROM comment c
        LEFT JOIN user u ON c.user_id = u.user_id
        WHERE c.board_id = #{board_id}
          AND c.post_id = #{post_id}
        ORDER BY c.created_at ASC
    </select>

    <!-- 댓글 ID로 댓글 조회 -->
    <select id="selectByCommentId" resultMap="CommentMap">
        SELECT 
            comment_id,
            board_id,
            post_id,
            user_id,
            parent_comment_id,
            content,
            created_at,
            is_deleted
        FROM comment
        WHERE board_id = #{board_id}
          AND post_id = #{post_id}
          AND comment_id = #{comment_id}
    </select>

    <!-- 댓글 등록 -->
    <insert id="insertComment"
        parameterType="com.mayonedev.battle.domain.board.entity.Comment"
        useGeneratedKeys="true"
        keyProperty="comment_id">

        INSERT INTO comment
            (board_id, post_id, user_id, parent_comment_id, content)
        VALUES
            (#{board_id}, #{post_id}, #{user_id}, #{parent_comment_id}, #{content})
    </insert>


    <!-- 댓글 삭제(soft delete version) -->
    <update id="softDeleteComment" parameterType="long">
        UPDATE comment
        SET is_deleted = 1
        WHERE comment_id = #{comment_id}
    </update>

    <!-- 댓글 삭제(hard delete version) -->
    <delete id="deleteComment" parameterType="long">
        DELETE FROM comment
        WHERE comment_id = #{comment_id}
    </delete>

</mapper>