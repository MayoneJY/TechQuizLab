<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mayonedev.battle.dao.BoardPostDao">
	<!-- 게시글 조회(All) -->
    <select id="selectPostAll" parameterType="board" resultType="com.mayonedev.battle.entity.Board">
        select * from board
    </select>
	<!-- 게시글 조회(user id) -->
    <select id="selectpostbyuserid" parameterType="int" resultType="com.mayonedev.battle.entity.Board">
        select * from board where user_id = #{id}
    </select>
	<!-- 게시글 조회(post id) -->
    <select id="selectByPostId" parameterType="int" resultType="com.mayonedev.battle.entity.Board">
        select * from board where id = #{id}
    </select>
    <!-- 게시글 조회(tags) -->
	<select id="selectByPostTags" parameterType="board" resultType="com.mayonedev.battle.entity.Board">
		select * from board where tags=#{tags}
	</select>    
	<!-- 게시글 조회(NickName) -->
    <select id="selectPostByNickName" parameterType="string" resultType="com.mayonedev.battle.entity.Board">
    
        select * 
        from board
        where user_id = (
            select id
            from user
            where nickname = #{nickname}
        )
    </select>
    <!-- 게시글 작성 -->
    <insert id="insertPost" parameterType="com.mayonedev.battle.entity.Board">
        insert into board (user_id, title, content, view, tags)
        VALUES (#{userId}, #{title}, #{content}, 0, #{tags})
    </insert>
    
	<!-- 게시글 수정 -->
    <update id="updatePost" parameterType="com.mayonedev.battle.entity.Board">
        update board set 
            title      = #{title},
            content    = #{content},
            view       = #{view},
            tags       = #{tags}
        where id 	   = #{id}
    </update>
    
	<!--게시글 삭제-->
    <delete id="deletePost" parameterType="int">
        delete from board where id = #{id}
    </delete>
    
	<!-- 게시글 조회수 저장 -->
	<update id="increaseViewCount" parameterType="int">
		update board
		SET view = view +1
		WHERE id = #{id}
	</update>
</mapper>