<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mayonedev.battle.dao.BoardPostDao">
	<!-- 모든 게시글 조회 -->
    <select id="selectPostAll" parameterType="board" resultType="com.mayonedev.battle.entity.Board">
        select * from board
    </select>
	<!-- 특정 게시글 조회(user id) -->
    <select id="selectpostbyuserid" parameterType="int" resultType="com.mayonedev.battle.entity.Board">
        select * from board where user_id = #{id}
    </select>
	<!-- 특정 게시글 조회(post id) -->
    <select id="selectByPostId" parameterType="int" resultType="com.mayonedev.battle.entity.Board">
        select * from board where id = #{id}
    </select>

    <select id="selectPostByNickName" parameterType="string" resultType="com.mayonedev.battle.entity.Board">
    
        select * 
        from board
        where user_id = (
            select id
            from user
            where nickname = #{nickname}
        )
    </select>
    <insert id="insertPost" parameterType="com.mayonedev.battle.entity.Board">
        insert into board (id, user_id, title, content, created_at, updated_at, view, tags)
        VALUES (#{id}, #{user_id}, #{title}, #{content}, #{created_at}, #{updated_at}, #{view}, #{tags})
    </insert>

    <update id="updatePost" parameterType="com.mayonedev.battle.entity.Board">
        update board set 
            title      = #{title},
            content    = #{content},
            updated_at = #{updated_at},
            view       = #{view},
            tags       = #{tags}
        where id = #{id}
    </update>

    <delete id="deletePost" parameterType="com.mayonedev.battle.entity.Board">
        delete from board where id = #{id}
    </delete>

</mapper>