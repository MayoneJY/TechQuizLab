<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mayonedev.battle.domain.gamification.dao.InterviewHistoryDao">

    <insert id="insert" parameterType="com.mayonedev.battle.domain.gamification.entity.InterviewHistory">
        INSERT INTO interview_history (user_id, stage_id, completed_at)
        VALUES (#{userId}, #{stageId}, #{completedAt})
    </insert>

</mapper>
